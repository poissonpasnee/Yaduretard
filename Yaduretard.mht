@charset "utf-8";

:root { --bg: #f6f3ef; --card: #fff; --text: #1f2937; --muted: #6b7280; --accent: #0f766e; --accent-dark: #115e59; --border: #e5e7eb; --shadow: 0 10px 30px rgba(17,24,39,.08); --success-bg: #e6f4ef; --success-text: #0f766e; --danger-bg: #fef2f2; --danger-text: #b91c1c; }

* { box-sizing: border-box; }

body { margin: 0px; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: linear-gradient(180deg,var(--bg),#fff 60%); color: var(--text); min-height: 100vh; }

.wrap { width: min(100%, 560px); margin: 0px auto; padding: 18px 14px 28px; }

.header { margin-bottom: 14px; }

.title { margin: 0px; font-size: 1.5rem; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; }

.subtitle { margin: 6px 0px 0px; font-size: 0.95rem; color: var(--muted); }

.card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow); padding: 18px; margin-bottom: 14px; }

.station { margin: 0px 0px 8px; font-size: 1.2rem; font-weight: 800; }

.status { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; font-weight: 700; margin: 0px 0px 14px; background: var(--success-bg); color: var(--success-text); }

.status::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: currentcolor; box-shadow: rgba(15, 118, 110, 0.12) 0px 0px 0px 4px; }

.message { margin: 0px 0px 16px; font-size: 1rem; line-height: 1.5; }

.grid { display: grid; gap: 10px; }

.row { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 12px 14px; border: 1px solid var(--border); border-radius: 14px; background: rgb(252, 252, 252); }

.label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 700; }

.value { font-size: 0.98rem; line-height: 1.35; word-break: break-word; }

.actions { display: grid; gap: 10px; margin-top: 8px; }

button { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 14px; padding: 14px 16px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: transform 0.06s, background 0.2s, opacity 0.2s; }

button:active { transform: scale(0.99); }

.primary { background: var(--accent); color: rgb(255, 255, 255); box-shadow: rgba(15, 118, 110, 0.22) 0px 8px 18px; }

.primary:hover { background: var(--accent-dark); }

.secondary { background: rgb(238, 242, 247); color: var(--text); }

.footer { margin-top: 12px; text-align: center; font-size: 0.85rem; color: var(--muted); }

.badge { display: inline-block; margin-top: 8px; padding: 6px 10px; border-radius: 999px; background: rgb(238, 242, 255); color: rgb(67, 56, 202); font-size: 0.82rem; font-weight: 700; }

.danger { background: var(--danger-bg) !important; color: var(--danger-text) !important; }

.danger::before { box-shadow: rgba(185, 28, 28, 0.12) 0px 0px 0px 4px; }

@media (min-width: 520px) {
  .title { font-size: 1.75rem; }
  .row { grid-template-columns: 140px 1fr; align-items: start; }
  .label { padding-top: 2px; }
}
